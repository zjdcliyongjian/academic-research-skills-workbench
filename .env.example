# Browser-visible Supabase configuration
VITE_DEPLOYMENT_MODE=cloud
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only configuration (set in Vercel Project Settings)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# One-time admin bootstrap only. Set these in a private terminal session, run
# `npm run cloud:bootstrap-admin`, then remove ADMIN_PASSWORD from the environment.
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=SET_A_STRONG_PRIVATE_PASSWORD_AT_RUNTIME

# 32 random bytes encoded as base64. Never expose this as a VITE_ variable.
BYOK_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Optional Upstash Redis. Used for rate limiting and short-lived job state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional QStash. Recommended before external trial users are invited.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_APP_URL=https://YOUR_PUBLIC_APP_DOMAIN.example

# Product-demo fallback: return the run immediately and continue through Vercel waitUntil.
# Keep this true only for short demonstrations; use QStash + Worker for public trials.
ALLOW_SYNCHRONOUS_DEMO_RUNS=true

# Per-account protection. This is enforced even without Redis; the in-memory
# request rate fallback is local-instance only, while Redis is cross-instance.
MAX_ACTIVE_RUNS_PER_USER=2

# Cross-user backpressure. Requires Upstash Redis; default is 20 active runs.
MAX_GLOBAL_ACTIVE_RUNS=20

# Local-server PDF parser. The cloud edition reads each user's encrypted
# PaddleOCR Token from the server-only model_configs vault and falls back to PDF.js + Tesseract when
# the current account has not configured one.
PDF_PARSER=auto
PADDLEOCR_ACCESS_TOKEN=
# Optional official-API-compatible proxy base URL for local deployments.
PADDLEOCR_BASE_URL=
